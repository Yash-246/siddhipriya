APP_NAME="Siddhipriya Gracia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Recommended on Vercel: cookie sessions are stateless and do not depend on
# the function filesystem. APP_KEY must be configured and kept stable.
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=array

# Preview fallback: omit these to use the bundled SQLite database copied to
# /tmp. Data written to /tmp is NOT durable between serverless instances.
# For production, configure a persistent MySQL database instead.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
